# Open Weather API Configuration
# Copy to .env and customize as needed

# Server
WX_HOST=0.0.0.0
WX_PORT=5580

# Cache TTL (seconds)
WX_CACHE_TTL=300        # 5 min for readings
WX_CACHE_TTL_LONG=3600  # 1 hr for station lists

# HTTP client
WX_HTTP_TIMEOUT=30

# Logging
WX_LOG_LEVEL=INFO       # DEBUG, INFO, WARNING, ERROR
WX_LOG_FORMAT=console   # console or json

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL API KEYS
#
# The vast majority of sources (USGS, NOAA, SNOTEL, RAWS, IEM, ACIS, CDEC,
# international met services, etc.) work with NO keys at all.
#
# These keys unlock additional sources or increase rate limits.
# Leave blank to skip those sources — everything else still works.
# ──────────────────────────────────────────────────────────────────────────────

# Synoptic Data (free tier: https://synopticdata.com)
SYNOPTIC_TOKEN=

# Air quality
AIRNOW_API_KEY=
OPENAQ_API_KEY=

# Citizen/personal weather networks
PURPLEAIR_KEY=
AMBIENT_APP_KEY=
AMBIENT_API_KEY=
WEATHERFLOW_TOKEN=
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=

# International met services (most have free registration)
FROST_CLIENT_ID=       # Norway MET.no
KNMI_API_KEY=          # Netherlands
AEMET_API_KEY=         # Spain
METEOFRANCE_KEY=       # France
KMA_SERVICE_KEY=       # South Korea
CWA_AUTH_KEY=          # Taiwan
DMI_API_KEY=           # Denmark
FMI_API_KEY=           # Finland
METEOCHILE_USER=       # Chile
METEOCHILE_TOKEN=

# Specialty
CIMIS_APP_KEY=         # California irrigation
NEON_TOKEN=            # NEON ecological
CBIBS_API_KEY=         # Chesapeake Bay buoys
NC_ECONET_HASH=        # NC ECONet
